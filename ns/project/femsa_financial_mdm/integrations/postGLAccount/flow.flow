interface project.femsa_financial_mdm.integrations
service postGLAccount (
    input {
        record sapCanonical (project.femsa_financial_mdm.documenttypes:sapCanonicalDT);
    }
    output {
        String httpStatus;
        String requestId;
        String requestStatus;
        String errorMessage;
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: public;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: When top-level service only;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    TRY {
        MAP {
            mapTarget {
                String glStatus;
            }
            set (variable) `glStatus` = "%sapCanonical/financialMaster/status%";
        }
        IF (glStatus=="ACTIVE") {
            MAP {
                mapTarget {
                    String isBlocked;
                }
                set `isBlocked` = "false";
            }
        } ELSE {
            MAP {
                mapTarget {
                    String isBlocked;
                }
                set `isBlocked` = "true";
            }
        }
        LOOP {
            inputArray: "/sapCanonical/financialMaster/descriptions"
            maxThreads: "1"
            parallelErrorHandling: "reportError"
            MAP {
                mapTarget {
                    String currentLanguage;
                    String currentText;
                }
                set (variable) `currentLanguage` = "%sapCanonical/financialMaster/descriptions/language%";
                set (variable) `currentText` = "%sapCanonical/financialMaster/descriptions/value%";
            }
            INVOKE pub.string:substring {
                validateInput: false
                validateOutput: false
                input {
                    copy `currentLanguage` -> `inString`;
                    set `beginIndex` = "0";
                    set `endIndex` = "2";
                }
                output {
                    mapTarget {
                        String langPrefix;
                    }
                    copy `value` -> `langPrefix`;
                }
            }
            INVOKE pub.string:toUpper {
                validateInput: false
                validateOutput: false
                input {
                    copy `langPrefix` -> `inString`;
                }
                output {
                    mapTarget {
                        String langCode;
                    }
                    copy `value` -> `langCode`;
                }
            }
            MAP {
                copy `langCode` -> `textItem`/`language`;
                copy `currentText` -> `textItem`/`shortText`;
            }
            INVOKE pub.json:documentToJSONString {
                validateInput: false
                validateOutput: false
                input {
                    copy `textItem` -> `document`;
                }
                output {
                    mapTarget {
                        String itemJson;
                    }
                    copy `jsonString` -> `itemJson`;
                    drop `document`;
                    drop `jsonString`;
                }
            }
            INVOKE pub.list:appendToStringList {
                validateInput: false
                validateOutput: false
                input {
                    copy `textsJsonList` -> `toList`;
                    copy `itemJson` -> `fromItem`;
                }
                output {
                    mapTarget {
                        String[] textsJsonList;
                    }
                    copy `toList` -> `textsJsonList`;
                    drop `toList`;
                }
            }
            MAP {
                drop `textItem`;
                drop `itemJson`;
            }
        }
        INVOKE pub.string:makeString {
            validateInput: false
            validateOutput: false
            input {
                copy `textsJsonList` -> `elementList`;
                set `separator` = ",";
            }
            output {
                mapTarget {
                    String textsJson;
                }
                copy `value` -> `textsJson`;
            }
        }
        LOOP {
            inputArray: "/sapCanonical/financialMaster/assignments"
            maxThreads: "1"
            parallelErrorHandling: "reportError"
            MAP {
                mapTarget {
                    record assignmentItem {
                        allowUnspecifiedFields: true;
                    } {
                        String companyCode;
                        String legalEntity;
                    };
                }
                set (variable) `assignmentItem`/`companyCode` = "%sapCanonical/financialMaster/assignments/companyCode%";
                set (variable) `assignmentItem`/`legalEntity` = "%sapCanonical/financialMaster/assignments/legalEntity%";
            }
            INVOKE pub.json:documentToJSONString {
                validateInput: false
                validateOutput: false
                input {
                    copy `assignmentItem` -> `document`;
                }
                output {
                    mapTarget {
                        String itemJson;
                    }
                    copy `jsonString` -> `itemJson`;
                    drop `document`;
                    drop `jsonString`;
                }
            }
            INVOKE pub.list:appendToStringList {
                validateInput: false
                validateOutput: false
                input {
                    copy `assignmentsJsonList` -> `toList`;
                    copy `itemJson` -> `fromItem`;
                }
                output {
                    mapTarget {
                        String[] assignmentsJsonList;
                    }
                    copy `toList` -> `assignmentsJsonList`;
                    drop `toList`;
                }
            }
            MAP {
                drop `assignmentItem`;
                drop `itemJson`;
            }
        }
        INVOKE pub.string:makeString {
            validateInput: false
            validateOutput: false
            input {
                copy `assignmentsJsonList` -> `elementList`;
                set `separator` = ",";
            }
            output {
                mapTarget {
                    String assignmentsJson;
                }
                copy `value` -> `assignmentsJson`;
            }
        }
        MAP {
            mapTarget {
                String requestJson;
            }
            set (variable) `requestJson` = {`chartOfAccounts`:"%sapCanonical/financialMaster/chartOfAccounts%",`glAccount`:"%sapCanonical/financialMaster/code%",`accountGroup`:"%sapCanonical/financialMaster/accountType%",`groupAccountNumber`:"%sapCanonical/financialMaster/groupAccount%",`validityStartDate`:"%sapCanonical/financialMaster/validFrom%",`isBlockedForPosting`:%isBlocked%,`texts`:[%textsJson%],`companyCodeAssignments`:[%assignmentsJson%],`sourceReference`:{`system`:"%sapCanonical/meta/sourceSystem%",`objectId`:"%sapCanonical/meta/globalMasterId%",`version`:%sapCanonical/meta/version%}};
        }
        MAP {
            mapTarget {
                record requestHeaders {
                    String Content-Type;
                    String Accept;
                    String Idempotency-Key;
                    String X-Correlation-ID;
                };
            }
            set `requestHeaders` = {`Content-Type`:"",`Accept`:"",`Idempotency-Key`:"",`X-Correlation-ID`:""};
        }
        MAP {
            mapTarget {
                record requestHeaders {
                    allowUnspecifiedFields: true;
                } {
                    String Content-Type;
                    String Accept;
                    String Idempotency-Key;
                    String X-Correlation-ID;
                };
            }
            set `requestHeaders`/`Content-Type` = "application/json";
            set `requestHeaders`/`Accept` = "application/json";
            set (variable) `requestHeaders`/`Idempotency-Key` = "%sapCanonical/meta/globalMasterId%:%sapCanonical/meta/version%";
            set (variable) `requestHeaders`/`X-Correlation-ID` = "%sapCanonical/meta/correlationId%";
        }
        INVOKE pub.client:http {
            validateInput: false
            validateOutput: false
            input {
                set `url` = "http://68.221.160.79:5002/sap/api/v1/gl-accounts";
                set `method` = "post";
                set `timeout` = "30000";
                copy `requestJson` -> `data`/`string`;
                set `data`/`encoding` = "UTF-8";
                copy `requestHeaders`/`Content-Type` -> `headers`/`Content-Type`;
                copy `requestHeaders`/`Accept` -> `headers`/`Accept`;
                copy `requestHeaders`/`Idempotency-Key` -> `headers`/`Idempotency-Key`;
                copy `requestHeaders`/`X-Correlation-ID` -> `headers`/`X-Correlation-ID`;
            }
        }
        INVOKE pub.string:bytesToString {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String encoding;
                }
                copy `body`/`bytes` -> `bytes`;
                set `encoding` = "UTF-8";
            }
            output {
                mapTarget {
                    String responseString;
                }
                copy `string` -> `responseString`;
            }
        }
        INVOKE pub.json:jsonStringToDocument {
            validateInput: false
            validateOutput: false
            input {
                copy `responseString` -> `jsonString`;
            }
        }
        MAP {
            copy `header`/`status` -> `httpStatus`;
            set (variable) `requestId` = "%document/requestId%";
            set (variable) `requestStatus` = "%document/status%";
            set (variable) `errorMessage` = "%document/error/message%";
        }
    } CATCH {
        INVOKE pub.flow:getLastError {
            validateInput: false
            validateOutput: false
        }
        MAP {
            copy `lastError`/`error` -> `errorMessage`;
        }
    }
}
