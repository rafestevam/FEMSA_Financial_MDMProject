interface project.femsa_financial_mdm.integrations
service postGLAccount (
    input {
        record sapCanonical {
            allowUnspecifiedFields: true;
        };
    }
    output {
        String httpStatus;
        String requestId;
        String requestStatus;
        String sapObjectId;
        String publicationStatus;
        String errorCode;
        String errorMessage;
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: public;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: When top-level service only;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    TRY {
        INVOKE pub.json:documentToJSONString {
            validateInput: false
            validateOutput: false
            input {
                copy `sapCanonical` -> `document`;
            }
            output {
                mapTarget {
                    String versionStr;
                }
                copy `jsonString` -> `versionStr`;
                drop `jsonString`;
                drop `document`;
            }
        }
        INVOKE pub.string:replace {
            validateInput: false
            validateOutput: false
            input {
                copy `versionStr` -> `inString`;
                set `searchString` = "^(?!.*.meta.:[{][^}]*.version.:[0-9]).*$";
                set `replaceString` = "";
                set `useRegex` = "true";
            }
            output {
                mapTarget {
                    String versionStr;
                }
                copy `value` -> `versionStr`;
                drop `value`;
                drop `inString`;
                drop `searchString`;
                drop `replaceString`;
                drop `useRegex`;
            }
        }
        INVOKE pub.string:replace {
            validateInput: false
            validateOutput: false
            input {
                copy `versionStr` -> `inString`;
                set `searchString` = "^.*.meta.:[{][^}]*.version.:([0-9]+).*$";
                set `replaceString` = "$1";
                set `useRegex` = "true";
            }
            output {
                mapTarget {
                    String versionStr;
                }
                copy `value` -> `versionStr`;
                drop `value`;
                drop `inString`;
                drop `searchString`;
                drop `replaceString`;
                drop `useRegex`;
            }
        }
        MAP {
            set (variable) `glStatus` = "%sapCanonical/financialMaster/status%";
            set `sapObjectId` = "";
            drop `publicationStatus`;
            drop `errorCode`;
            drop `errorMessage`;
        }
        IF (glStatus=="ACTIVE") {
            MAP {
                mapTarget {
                    String isBlocked;
                }
                set `isBlocked` = "false";
            }
        } ELSE {
            IF (glStatus=="INACTIVE") {
                MAP {
                    mapTarget {
                        String isBlocked;
                    }
                    set `isBlocked` = "true";
                }
            } ELSE {
                MAP {
                    mapTarget {
                        String publicationStatus;
                        String errorCode;
                        String errorMessage;
                    }
                    set `publicationStatus` = "QUARANTINED";
                    set `errorCode` = "WM_STATUS_UNMAPPED";
                    set (variable) `errorMessage` = "Status '%glStatus%' sem mapeamento para isBlockedForPosting; registro em quarentena, nao enviado ao SAP";
                }
            }
        }
        IF (publicationStatus==$null) {
            MAP {
                drop `toList`;
                drop `elementList`;
            }
            LOOP {
                inputArray: "/sapCanonical/financialMaster/descriptions"
                maxThreads: "1"
                parallelErrorHandling: "reportError"
                MAP {
                    mapTarget {
                        String currentLanguage;
                        String currentText;
                    }
                    set (variable) `currentLanguage` = "%sapCanonical/financialMaster/descriptions/language%";
                    set (variable) `currentText` = "%sapCanonical/financialMaster/descriptions/value%";
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `currentText` -> `inString`;
                        set `searchString` = "^(.{50}).*$";
                        set `replaceString` = "$1";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String currentText;
                        }
                        copy `value` -> `currentText`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.string:substring {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `currentLanguage` -> `inString`;
                        set `beginIndex` = "0";
                        set `endIndex` = "2";
                    }
                    output {
                        mapTarget {
                            String langPrefix;
                        }
                        copy `value` -> `langPrefix`;
                        drop `value`;
                        drop `beginIndex`;
                        drop `endIndex`;
                    }
                }
                INVOKE pub.string:toUpper {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `langPrefix` -> `inString`;
                    }
                    output {
                        mapTarget {
                            String langCode;
                        }
                        copy `value` -> `langCode`;
                        drop `value`;
                    }
                }
                MAP {
                    mapSource {
                        String langCode;
                        String currentText;
                    }
                    mapTarget {
                        record textItem {
                            allowUnspecifiedFields: true;
                        } {
                            String language;
                            String shortText;
                        };
                    }
                    copy `langCode` -> `textItem`/`language`;
                    copy `currentText` -> `textItem`/`shortText`;
                    drop `currentLanguage`;
                    drop `currentText`;
                    drop `langPrefix`;
                    drop `langCode`;
                    drop `inString`;
                }
                INVOKE pub.json:documentToJSONString {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `textItem` -> `document`;
                    }
                    output {
                        mapTarget {
                            String itemJson;
                        }
                        copy `jsonString` -> `itemJson`;
                        drop `document`;
                        drop `jsonString`;
                    }
                }
                INVOKE pub.list:appendToStringList {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `itemJson` -> `fromItem`;
                    }
                    output {
                        mapTarget {
                            String[] elementList;
                        }
                        copy `toList` -> `elementList`;
                        drop `fromItem`;
                        drop `itemJson`;
                        drop `textItem`;
                    }
                }
            }
            IF (toList==$null) {
                MAP {
                    mapTarget {
                        String textsJson;
                    }
                    set `textsJson` = "";
                }
            } ELSE {
                INVOKE pub.string:makeString {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String separator;
                        }
                        set `separator` = ",";
                    }
                    output {
                        mapTarget {
                            String textsJson;
                        }
                        copy `value` -> `textsJson`;
                        drop `value`;
                        drop `toList`;
                        drop `elementList`;
                        drop `separator`;
                    }
                }
            }
            MAP {
                drop `toList`;
                drop `elementList`;
            }
            LOOP {
                inputArray: "/sapCanonical/financialMaster/assignments"
                maxThreads: "1"
                parallelErrorHandling: "reportError"
                MAP {
                    mapTarget {
                        record assignmentItem {
                            allowUnspecifiedFields: true;
                        } {
                            String companyCode;
                            String legalEntity;
                        };
                    }
                    set (variable) `assignmentItem`/`companyCode` = "%sapCanonical/financialMaster/assignments/companyCode%";
                    set (variable) `assignmentItem`/`legalEntity` = "%sapCanonical/financialMaster/assignments/legalEntity%";
                }
                INVOKE pub.json:documentToJSONString {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `assignmentItem` -> `document`;
                    }
                    output {
                        mapTarget {
                            String itemJson;
                        }
                        copy `jsonString` -> `itemJson`;
                        drop `document`;
                        drop `jsonString`;
                    }
                }
                INVOKE pub.list:appendToStringList {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `itemJson` -> `fromItem`;
                    }
                    output {
                        mapTarget {
                            String[] elementList;
                        }
                        copy `toList` -> `elementList`;
                        drop `fromItem`;
                        drop `itemJson`;
                        drop `assignmentItem`;
                    }
                }
            }
            IF (toList==$null) {
                MAP {
                    mapTarget {
                        String assignmentsJson;
                    }
                    set `assignmentsJson` = "";
                }
            } ELSE {
                INVOKE pub.string:makeString {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String separator;
                        }
                        set `separator` = ",";
                    }
                    output {
                        mapTarget {
                            String assignmentsJson;
                        }
                        copy `value` -> `assignmentsJson`;
                        drop `value`;
                        drop `toList`;
                        drop `elementList`;
                        drop `separator`;
                    }
                }
            }
            MAP {
                drop `toList`;
                drop `elementList`;
            }
            MAP {
                mapTarget {
                    record sourceReference {
                        allowUnspecifiedFields: true;
                    } {
                        String system;
                        String objectId;
                        String version;
                    };
                }
                set `sourceReference`/`system` = "STIBO_STEP";
                set (variable) `sourceReference`/`objectId` = "%sapCanonical/meta/globalMasterId%";
                set (variable) `sourceReference`/`version` = "%versionStr%";
            }
            MAP {
                mapSource {
                    record sourceReference;
                }
                mapTarget {
                    record requestDoc {
                        allowUnspecifiedFields: true;
                    } {
                        record sourceReference {
                            allowUnspecifiedFields: true;
                        };
                        String chartOfAccounts;
                        String glAccount;
                        String accountGroup;
                        String groupAccountNumber;
                        String validityStartDate;
                    };
                }
                set (variable) `requestDoc`/`chartOfAccounts` = "%sapCanonical/financialMaster/chartOfAccounts%";
                set (variable) `requestDoc`/`glAccount` = "%sapCanonical/financialMaster/code%";
                set (variable) `requestDoc`/`accountGroup` = "%sapCanonical/financialMaster/accountType%";
                set (variable) `requestDoc`/`groupAccountNumber` = "%sapCanonical/financialMaster/groupAccount%";
                set (variable) `requestDoc`/`validityStartDate` = "%sapCanonical/financialMaster/validFrom%";
                copy `sourceReference` -> `requestDoc`/`sourceReference`;
                drop `sourceReference`;
            }
            INVOKE pub.json:documentToJSONString {
                validateInput: false
                validateOutput: false
                input {
                    copy `requestDoc` -> `document`;
                }
                output {
                    mapTarget {
                        String headerJson;
                    }
                    copy `jsonString` -> `headerJson`;
                    drop `document`;
                    drop `jsonString`;
                    drop `requestDoc`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `headerJson` -> `inString`;
                    set `searchString` = "(.version.:).([0-9]+).";
                    set `replaceString` = "$1$2";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String headerJson;
                    }
                    copy `value` -> `headerJson`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `headerJson` -> `inString`;
                    set `searchString` = "[}]$";
                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String headerJson;
                    }
                    copy `value` -> `headerJson`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            MAP {
                mapTarget {
                    String jsonTail;
                }
                set (variable) `jsonTail` = ",\"isBlockedForPosting\":%isBlocked%,\"texts\":[%textsJson%],\"companyCodeAssignments\":[%assignmentsJson%]}";
            }
            INVOKE pub.string:concat {
                validateInput: false
                validateOutput: false
                input {
                    copy `headerJson` -> `inString1`;
                    copy `jsonTail` -> `inString2`;
                }
                output {
                    mapTarget {
                        String requestJson;
                    }
                    copy `value` -> `requestJson`;
                    drop `value`;
                    drop `inString1`;
                    drop `inString2`;
                    drop `headerJson`;
                    drop `jsonTail`;
                }
            }
            MAP {
                mapTarget {
                    record requestHeaders {
                        allowUnspecifiedFields: true;
                    } {
                        String Content-Type;
                        String Accept;
                        String Idempotency-Key;
                        String X-Correlation-ID;
                    };
                }
                set `requestHeaders`/`Content-Type` = "application/json";
                set `requestHeaders`/`Accept` = "application/json";
                set (variable) `requestHeaders`/`Idempotency-Key` = "%sapCanonical/meta/globalMasterId%:%versionStr%";
                set (variable) `requestHeaders`/`X-Correlation-ID` = "%sapCanonical/meta/correlationId%";
            }
            INVOKE pub.client:http {
                validateInput: false
                validateOutput: false
                input {
                    set `url` = "http://68.221.160.79:5002/sap/api/v1/gl-accounts";
                    set `method` = "post";
                    set `timeout` = "30000";
                    copy `requestJson` -> `data`/`string`;
                    set `data`/`encoding` = "UTF-8";
                    copy `requestHeaders` -> `headers`;
                }
            }
            INVOKE pub.string:bytesToString {
                validateInput: false
                validateOutput: false
                input {
                    mapTarget {
                        String encoding;
                    }
                    copy `body`/`bytes` -> `bytes`;
                    set `encoding` = "UTF-8";
                }
                output {
                    mapTarget {
                        String responseString;
                    }
                    copy `string` -> `responseString`;
                    drop `string`;
                    drop `bytes`;
                    drop `encoding`;
                }
            }
            INVOKE pub.json:jsonStringToDocument {
                validateInput: false
                validateOutput: false
                input {
                    copy `responseString` -> `jsonString`;
                }
            }
            MAP {
                mapSource {
                    record header;
                }
                mapTarget {
                    String httpStatus;
                    String requestId;
                    String requestStatus;
                    String errorMessage;
                }
                copy `header`/`status` -> `httpStatus`;
                set (variable) `requestId` = "%document/requestId%";
                set (variable) `requestStatus` = "%document/status%";
                set (variable) `errorMessage` = "%document/error/message%";
                drop `jsonString`;
                drop `responseString`;
                drop `body`;
                drop `header`;
                drop `data`;
                drop `headers`;
                drop `url`;
                drop `method`;
                drop `requestJson`;
                drop `encodedURL`;
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `requestId` -> `inString`;
                    set `searchString` = "^%[^%]*%$";
                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String requestId;
                    }
                    copy `value` -> `requestId`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `requestStatus` -> `inString`;
                    set `searchString` = "^%[^%]*%$";
                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String requestStatus;
                    }
                    copy `value` -> `requestStatus`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `errorMessage` -> `inString`;
                    set `searchString` = "^%[^%]*%$";
                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String errorMessage;
                    }
                    copy `value` -> `errorMessage`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            IF (httpStatus=="202"||httpStatus=="200") {
                MAP {
                    mapTarget {
                        record pollHeaders {
                            allowUnspecifiedFields: true;
                        } {
                            String Accept;
                            String X-Correlation-ID;
                        };
                    }
                    set `pollHeaders`/`Accept` = "application/json";
                    set (variable) `pollHeaders`/`X-Correlation-ID` = "%sapCanonical/meta/correlationId%";
                }
                REPEAT {
                    count: 10
                    repeatInterval: 2
                    SEQUENCE {
                        label: "pollAttempt"
                        INVOKE pub.client:http {
                            validateInput: false
                            validateOutput: false
                            input {
                                mapTarget {
                                    String url;
                                    String method;
                                }
                                set (variable) `url` = "http://68.221.160.79:5002/sap/api/v1/requests/%requestId%";
                                set `method` = "get";
                                set `timeout` = "30000";
                                copy `pollHeaders` -> `headers`;
                            }
                        }
                        MAP {
                            copy `header`/`status` -> `pollError`;
                        }
                        INVOKE pub.string:replace {
                            validateInput: false
                            validateOutput: false
                            input {
                                copy `pollError` -> `inString`;
                                set `searchString` = "^(?:(4(?:0[1-9]|[1-9][0-9])|5[0-9][0-9])|.*)$";
                                set `replaceString` = "$1";
                                set `useRegex` = "true";
                            }
                            output {
                                mapTarget {
                                    String pollError;
                                }
                                copy `value` -> `pollError`;
                                drop `value`;
                                drop `inString`;
                                drop `searchString`;
                                drop `replaceString`;
                                drop `useRegex`;
                            }
                        }
                        IF (pollError!=$null&&pollError!="") {
                            MAP {
                                mapTarget {
                                    String httpStatus;
                                    String requestStatus;
                                    String errorMessage;
                                }
                                set (variable) `httpStatus` = "%pollError%";
                                set `requestStatus` = "HTTP_ERROR";
                                set (variable) `errorMessage` = "Falha HTTP %pollError% ao consultar a requisicao SAP %requestId%";
                                drop `pollError`;
                                drop `body`;
                                drop `header`;
                                drop `headers`;
                                drop `url`;
                                drop `method`;
                                drop `encodedURL`;
                            }
                            EXIT {
                                exitFrom: "$loop"
                                signal: "SUCCESS"
                            }
                        }
                        INVOKE pub.string:bytesToString {
                            validateInput: false
                            validateOutput: false
                            input {
                                mapTarget {
                                    String encoding;
                                }
                                copy `body`/`bytes` -> `bytes`;
                                set `encoding` = "UTF-8";
                            }
                            output {
                                mapTarget {
                                    String responseString;
                                }
                                copy `string` -> `responseString`;
                                drop `string`;
                                drop `bytes`;
                                drop `encoding`;
                            }
                        }
                        INVOKE pub.json:jsonStringToDocument {
                            validateInput: false
                            validateOutput: false
                            input {
                                copy `responseString` -> `jsonString`;
                            }
                        }
                        MAP {
                            mapTarget {
                                String requestStatus;
                                String sapObjectId;
                            }
                            set (variable) `requestStatus` = "%document/status%";
                            set (variable) `sapObjectId` = "%document/sapObjectId%";
                            drop `pollError`;
                            drop `jsonString`;
                            drop `responseString`;
                            drop `body`;
                            drop `header`;
                            drop `headers`;
                            drop `url`;
                            drop `method`;
                            drop `encodedURL`;
                        }
                        IF (requestStatus!="APPLIED"&&requestStatus!="REJECTED") {
                            EXIT {
                                exitFrom: "pollAttempt"
                                signal: "FAILURE"
                                failureMessage: "Requisicao SAP ainda nao concluida"
                            }
                        }
                    }
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `sapObjectId` -> `inString`;
                        set `searchString` = "^%[^%]*%$";
                        set `replaceString` = "";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String sapObjectId;
                        }
                        copy `value` -> `sapObjectId`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                MAP {
                    mapTarget {
                        String publicationStatus;
                    }
                    set (variable) `publicationStatus` = "%requestStatus%";
                    drop `pollHeaders`;
                }
            } ELSE {
                IF (httpStatus=="400"||httpStatus=="422") {
                    MAP {
                        mapTarget {
                            String publicationStatus;
                        }
                        set `publicationStatus` = "REJECTED";
                    }
                }
            }
            MAP {
                drop `toList`;
                drop `elementList`;
                drop `errorCode`;
            }
            LOOP {
                inputArray: "/document/errors"
                maxThreads: "1"
                parallelErrorHandling: "reportError"
                MAP {
                    mapTarget {
                        String itemError;
                    }
                    set (variable) `itemError` = "%document/errors/code%: %document/errors/message%";
                }
                IF (errorCode==$null) {
                    MAP {
                        mapTarget {
                            String errorCode;
                        }
                        set (variable) `errorCode` = "%document/errors/code%";
                    }
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `itemError` -> `inString`;
                        set `searchString` = "%document/errors/[A-Za-z]+%";
                        set `replaceString` = "";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String itemError;
                        }
                        copy `value` -> `itemError`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.list:appendToStringList {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `itemError` -> `fromItem`;
                    }
                    output {
                        mapTarget {
                            String[] elementList;
                        }
                        copy `toList` -> `elementList`;
                        drop `fromItem`;
                        drop `itemError`;
                    }
                }
            }
            IF (toList==$null) {
                MAP {
                    mapTarget {
                        String errorCode;
                    }
                    set (variable) `errorCode` = "%document/error/code%";
                }
            } ELSE {
                INVOKE pub.string:makeString {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String separator;
                        }
                        set `separator` = " | ";
                    }
                    output {
                        mapTarget {
                            String errorMessage;
                        }
                        copy `value` -> `errorMessage`;
                        drop `value`;
                        drop `toList`;
                        drop `elementList`;
                        drop `separator`;
                    }
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `errorCode` -> `inString`;
                    set `searchString` = "^%[^%]*%$";
                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String errorCode;
                    }
                    copy `value` -> `errorCode`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            MAP {
                drop `document`;
                drop `toList`;
                drop `elementList`;
            }
        }
    } CATCH {
        INVOKE pub.flow:getLastError {
            validateInput: false
            validateOutput: false
        }
        MAP {
            copy `lastError`/`error` -> `errorMessage`;
            set `errorCode` = "WM_EXCEPTION";
        }
        INVOKE pub.string:replace {
            validateInput: false
            validateOutput: false
            input {
                copy `errorMessage` -> `inString`;
                set `searchString` = "(?s)^(?:.*Net(4(?:0[1-9]|[1-9][0-9])|5[0-9][0-9])Exception.*|.*)$";
                set `replaceString` = "$1";
                set `useRegex` = "true";
            }
            output {
                mapTarget {
                    String httpStatus;
                }
                copy `value` -> `httpStatus`;
                drop `value`;
                drop `inString`;
                drop `searchString`;
                drop `replaceString`;
                drop `useRegex`;
            }
        }
    }
}
