                        }
                        set `callbackStatus` = "REJECTED";
                    }
                } ELSE {
                    MAP {
                        mapTarget {
                            String callbackStatus;
                        }
                        set `callbackStatus` = "QUARANTINED";
                    }
                }
            }
            INVOKE pub.datetime:build {
                validateInput: false
                validateOutput: false
                input {
                    mapTarget {
                        String `pattern`;
                        String timezone;
                    }
                    set `pattern` = "yyyy-MM-dd'T'HH:mm:ss'Z'";
                    set `timezone` = "UTC";
                }
                output {
                    mapTarget {
                        String confirmedAt;
                    }
                    copy `value` -> `confirmedAt`;
                    drop `value`;
                    drop `pattern`;
                    drop `timezone`;
                }
            }
            MAP {
                mapTarget {
                    String callbackJson;
                    record callbackHeaders {
                        allowUnspecifiedFields: true;
                    } {
                        String Content-Type;
                    };
                }
                set (variable) `callbackJson` = "@{\"stepId\":\"%sapCanonical/meta/globalMasterId%\",\"version\":%versionStr%,\"target\":\"SAP\",\"status\":\"%callbackStatus%\",\"targetObjectId\":\"%sapObjectId%\",\"targetRequestId\":\"%requestId%\",\"correlationId\":\"%sapCanonical/meta/correlationId%\",\"confirmedAt\":\"%confirmedAt%\"}";
                set `callbackHeaders`/`Content-Type` = "application/json";
                drop `confirmedAt`;
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `callbackJson` -> `inString`;
                    set `searchString` = "^@";
                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String callbackJson;
                    }
                    copy `value` -> `callbackJson`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
