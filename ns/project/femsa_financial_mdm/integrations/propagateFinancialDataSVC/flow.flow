interface project.femsa_financial_mdm.integrations
service propagateFinancialDataSVC (
    input {
        String jsonPayload;
    }
    output {
        String jsonCanonical;
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: public;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: When top-level service only;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    SEQUENCE {
        label: "NEW"
        INVOKE pub.flow:debugLog {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                set `message` = "Empezando el mapeo en Mexico";
                set `function` = "project.femsa_financial_mdm.integrations:propagateFinancialDataSVC";
                set `level` = "Info";
            }
            output {
                drop `message`;
                drop `function`;
                drop `level`;
            }
        }
        INVOKE pub.json:jsonToDocument {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    Object jsonData;
                    String documentTypeName;
                }
                copy `jsonPayload` -> `jsonData`;
                set `documentTypeName` = "project.femsa_financial_mdm.documenttypes:financialApprovedDT";
            }
            output {
                mapTarget {
                    record financialApproved (project.femsa_financial_mdm.documenttypes:financialApprovedDT) {
                        allowUnspecifiedFields: true;
                    } {
                        String eventType;
                        String eventId;
                        String correlationId;
                        String occurredAt;
                        record source {
                            allowUnspecifiedFields: true;
                        } {
                            String system;
                            String environment;
                        };
                        record masterData {
                            allowUnspecifiedFields: true;
                        } {
                            String stepId;
                            Long version;
                            String objectType;
                            String status;
                            String effectiveDate;
                            record chartOfAccounts {
                                allowUnspecifiedFields: true;
                            } {
                                String stepId;
                                String code;
                            };
                            record account {
                                allowUnspecifiedFields: true;
                            } {
                                String code;
                                record description {
                                    allowUnspecifiedFields: true;
                                } {
                                    String es-MX;
                                    String pt-BR;
                                    String en-US;
                                };
                                String primaryLanguage;
                                String accountType;
                                String groupAccount;
                                String costCategory;
                            };
                            recordList organizationalAssignments {
                                allowUnspecifiedFields: true;
                            } {
                                String legalEntity;
                                String companyCode;
                            };
                        };
                    };
                }
                copy `document` -> `financialApproved`;
                drop `jsonPayload`;
                drop `document`;
                drop `jsonData`;
                drop `documentTypeName`;
            }
        }
        MAP {
            mapTarget {
                record sapCanonical (project.femsa_financial_mdm.documenttypes:sapCanonicalDT) {
                    allowUnspecifiedFields: true;
                } {
                    record meta {
                        allowUnspecifiedFields: true;
                    } {
                        String globalMasterId;
                        Long version;
                        String correlationId;
                        String eventType;
                        String sourceSystem;
                        String sourceEventId;
                        String occurredAt;
                    };
                    record financialMaster {
                        allowUnspecifiedFields: true;
                    } {
                        String type;
                        String code;
                        String status;
                        String validFrom;
                        String chartOfAccounts;
                        String accountType;
                        String groupAccount;
                        String costCategory;
                        recordList descriptions {
                            allowUnspecifiedFields: true;
                        } {
                            String language;
                            String value;
                        };
                        recordList assignments {
                            allowUnspecifiedFields: true;
                        } {
                            String legalEntity;
                            String companyCode;
                        };
                        recordList dependencies {
                            allowUnspecifiedFields: true;
                        } {
                            String type;
                            String globalMasterId;
                            String code;
                        };
                    };
                };
            }
            copy `financialApproved`/`correlationId` -> `sapCanonical`/`meta`/`correlationId`;
            copy `financialApproved`/`eventType` -> `sapCanonical`/`meta`/`eventType`;
            copy `financialApproved`/`occurredAt` -> `sapCanonical`/`meta`/`occurredAt`;
            copy `financialApproved`/`masterData`/`stepId` -> `sapCanonical`/`meta`/`globalMasterId`;
            copy `financialApproved`/`masterData`/`version` -> `sapCanonical`/`meta`/`version`;
            copy `financialApproved`/`source`/`system` -> `sapCanonical`/`meta`/`sourceSystem`;
            copy `financialApproved`/`source`/`environment` -> `sapCanonical`/`meta`/`sourceEventId`;
            copy `financialApproved`/`masterData`/`objectType` -> `sapCanonical`/`financialMaster`/`type`;
            copy `financialApproved`/`masterData`/`status` -> `sapCanonical`/`financialMaster`/`status`;
            copy `financialApproved`/`masterData`/`effectiveDate` -> `sapCanonical`/`financialMaster`/`validFrom`;
        }
        INVOKE pub.json:documentToJSON {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    record document {
                        allowUnspecifiedFields: true;
                    };
                }
                copy `sapCanonical` -> `document`;
            }
            output {
                mapTarget {
                    String jsonCanonical;
                }
                copy `jsonObj` -> `jsonCanonical`;
                drop `jsonObj`;
                drop `financialApproved`;
                drop `document`;
            }
        }
        INVOKE project.femsa_financial_mdm.integrations:postGLAccount {
            validateInput: false
            validateOutput: false
        }
        INVOKE pub.flow:debugLog {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String function;
                    String level;
                    String message;
                }
                set `function` = "project.femsa_financial_mdm.integrations:propagateFinancialDataSVC";
                set `level` = "Info";
                set `message` = "Terminando el mapeo en Mexico";
            }
            output {
                drop `message`;
                drop `function`;
                drop `level`;
            }
        }
    }
}
