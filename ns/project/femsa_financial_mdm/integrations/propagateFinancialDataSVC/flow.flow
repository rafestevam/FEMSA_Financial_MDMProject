                        drop `document`;
                        drop `jsonString`;
                    }
                }
                INVOKE pub.list:appendToStringList {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `itemJson` -> `fromItem`;
                    }
                    output {
                        drop `fromItem`;
                        drop `itemJson`;
                        drop `assignmentItem`;
                    }
                }
            }
            IF (toList==$null) {
