interface project.femsa_financial_mdm.integrations
service propagateFinancialDataSVC (
    input {
        String jsonPayload;
    }
    output {
        String jsonCanonical;
        String httpStatus;
        String i3HttpStatus;
        String callbackStatus;
        String errorCode;
        String errorMessage;
        String httpCode;
        String errorDump;
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: public;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: When top-level service only;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    TRY {
        SEQUENCE {
            label: "mainFlow"
            MAP {
                drop `httpCode`;
