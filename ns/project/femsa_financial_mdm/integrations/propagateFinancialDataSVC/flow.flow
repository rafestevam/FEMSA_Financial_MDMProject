                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String versionStr;
                    }
                    copy `value` -> `versionStr`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `versionStr` -> `inString`;
                    set `searchString` = "^.*.version.:([0-9]+).*$";
                    set `replaceString` = "$1";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
