                    }
                    set (variable) `assignmentItem`/`legalEntity` = "%financialApproved/masterData/organizationalAssignments/legalEntity%";
                    set (variable) `assignmentItem`/`companyCode` = "%financialApproved/masterData/organizationalAssignments/companyCode%";
                }
                INVOKE pub.json:documentToJSONString {
