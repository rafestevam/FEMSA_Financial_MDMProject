                        }
                        set `httpCode` = "422";
                    }
                } ELSE {
                    MAP {
                        mapTarget {
                            String httpCode;
                        }
                        set `httpCode` = "500";
                    }
                }
                MAP {
                    mapTarget {
                        String errorDump;
                    }
                    set (variable) `errorDump` = "Falha na publicacao SAP %sapCanonical/meta/globalMasterId% (status %publicationStatus%, callback %callbackStatus%, HTTP %httpStatus%, codigo %errorCode%): %errorMessage%";
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
