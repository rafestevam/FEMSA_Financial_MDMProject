                }
                set (variable) `canonicalJson` = "@{\"meta\":{\"globalMasterId\":\"%financialApproved/masterData/stepId%\",\"version\":%versionStr%,\"correlationId\":\"%financialApproved/correlationId%\",\"eventType\":\"MASTER_DATA_CHANGED\",\"sourceSystem\":\"STIBO_STEP\",\"sourceEventId\":\"%financialApproved/eventId%\",\"occurredAt\":\"%financialApproved/occurredAt%\"},\"financialMaster\":{\"type\":\"%financialApproved/masterData/objectType%\",\"code\":\"%financialApproved/masterData/account/code%\",\"status\":\"%financialApproved/masterData/status%\",\"validFrom\":\"%financialApproved/masterData/effectiveDate%\",\"chartOfAccounts\":\"%financialApproved/masterData/chartOfAccounts/code%\",\"accountType\":\"%financialApproved/masterData/account/accountType%\",\"groupAccount\":\"%financialApproved/masterData/account/groupAccount%\",\"costCategory\":\"%financialApproved/masterData/account/costCategory%\",\"descriptions\":[%descriptionsJson%],\"assignments\":[%assignmentsJson%],\"dependencies\":[{\"type\":\"CHART_OF_ACCOUNTS\",\"globalMasterId\":\"%financialApproved/masterData/chartOfAccounts/stepId%\",\"code\":\"%financialApproved/masterData/chartOfAccounts/code%\"}]}}";
                drop `descriptionsJson`;
                drop `assignmentsJson`;
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `canonicalJson` -> `inString`;
                    set `searchString` = "^@";
                    set `replaceString` = "";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String canonicalJson;
                    }
                    copy `value` -> `canonicalJson`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.json:jsonToDocument {
                validateInput: false
                validateOutput: false
                input {
                    copy `canonicalJson` -> `jsonData`;
                    set `documentTypeName` = "project.femsa_financial_mdm.documenttypes:sapCanonicalDT";
                }
                output {
                    mapSource {
                        String canonicalJson;
                    }
                    mapTarget {
                        record sapCanonical {
                            allowUnspecifiedFields: true;
                        };
                        String jsonCanonical;
                    }
                    copy `document` -> `sapCanonical`;
                    copy `canonicalJson` -> `jsonCanonical`;
                    drop `document`;
                    drop `jsonData`;
                    drop `documentTypeName`;
                    drop `canonicalJson`;
                    drop `financialApproved`;
                }
            }
            INVOKE project.femsa_financial_mdm.integrations:postGLAccount {
                validateInput: false
                validateOutput: false
            }
            IF (publicationStatus=="APPLIED") {
                MAP {
                    mapTarget {
