                    }
                    copy `value` -> `descriptionsJson`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `descriptionsJson` -> `inString`;
                    set `searchString` = "^[{](.*)[}]$";
                    set `replaceString` = "$1";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
                        String descriptionsJson;
                    }
                    copy `value` -> `descriptionsJson`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            MAP {
                drop `toList`;
            }
            LOOP {
                inputArray: "/financialApproved/masterData/organizationalAssignments"
                maxThreads: "1"
                parallelErrorHandling: "reportError"
                MAP {
                    mapTarget {
