                    }
                    copy `value` -> `versionStr`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            INVOKE pub.json:documentToJSONString {
                validateInput: false
                validateOutput: false
                input {
                    copy `financialApproved`/`masterData`/`account`/`description` -> `document`;
                }
                output {
                    mapTarget {
                        String descriptionsJson;
                    }
                    copy `jsonString` -> `descriptionsJson`;
                    drop `jsonString`;
                    drop `document`;
                }
            }
            INVOKE pub.string:replace {
                validateInput: false
                validateOutput: false
                input {
                    copy `descriptionsJson` -> `inString`;
                    set `searchString` = "([{,]).([a-zA-Z-]+).:.(.*?).(?=,.[a-zA-Z-]+.:|[}]$)";
                    set `replaceString` = "$1{\"language\":\"$2\",\"value\":\"$3\"}";
                    set `useRegex` = "true";
                }
                output {
                    mapTarget {
