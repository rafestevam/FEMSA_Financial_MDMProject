                    }
                    copy `value` -> `errorDump`;
                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            IF (errorDump==$null||errorDump=="") {
                MAP {
                    mapTarget {
                        String errorDump;
                    }
                    set (variable) `errorDump` = "%lastError/error%";
                }
            }
        }
        INVOKE pub.flow:setResponseCode {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String reasonPhrase;
                }
                copy `httpCode` -> `responseCode`;
                set `reasonPhrase` = "";
            }
            output {
                drop `responseCode`;
                drop `reasonPhrase`;
            }
        }
        INVOKE pub.flow:debugLog {
            validateInput: false
            validateOutput: false
            input {
                mapTarget {
                    String message;
                    String function;
                    String level;
                }
                set (variable) `message` = "propagateFinancialDataSVC falhou com HTTP %httpCode%: %errorDump%";
                set `function` = "project.femsa_financial_mdm.integrations:propagateFinancialDataSVC";
                set `level` = "Error";
            }
            output {
                drop `message`;
                drop `function`;
                drop `level`;
            }
        }
        MAP {
            drop `sapOk`;
            drop `i3Error`;
            drop `callbackJson`;
            drop `callbackHeaders`;
            drop `versionStr`;
            drop `sapCanonical`;
            drop `financialApproved`;
            drop `canonicalJson`;
            drop `descriptionsJson`;
            drop `assignmentsJson`;
            drop `confirmedAt`;
            drop `toList`;
            drop `document`;
            drop `jsonData`;
            drop `jsonPayload`;
            drop `documentTypeName`;
        }
    }
    IF (httpCode>=400) {
        EXIT {
            exitFrom: "$flow"
            signal: "FAILURE"
            failureMessage: "HTTP %httpCode%: %errorDump%"
        }
    }
}
