                        String message;
                    }
                    set `function` = "project.femsa_financial_mdm.integrations:propagateFinancialDataSVC";
                    set `level` = "Info";
                    set `message` = "Terminando el mapeo en Mexico";
                }
                output {
                    drop `message`;
                    drop `function`;
