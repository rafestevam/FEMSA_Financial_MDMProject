                    drop `value`;
                    drop `inString`;
                    drop `searchString`;
                    drop `replaceString`;
                    drop `useRegex`;
                }
            }
            IF (errorMessage!=$null&&errorMessage!="") {
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `errorCode` -> `inString`;
                        set `searchString` = "([\"\\\\])";
                        set `replaceString` = "\\\\$1";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String errorCode;
                        }
                        copy `value` -> `errorCode`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String searchString;
                            String replaceString;
                            String useRegex;
                        }
                        copy `errorCode` -> `inString`;
                        set `searchString` = "\\p{Cntrl}";
                        set `replaceString` = " ";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String errorCode;
                        }
                        copy `value` -> `errorCode`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String searchString;
                            String replaceString;
                            String useRegex;
                        }
                        copy `errorMessage` -> `inString`;
                        set `searchString` = "([\"\\\\])";
                        set `replaceString` = "\\\\$1";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String errorMessage;
                        }
                        copy `value` -> `errorMessage`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String searchString;
                            String replaceString;
                            String useRegex;
                        }
                        copy `errorMessage` -> `inString`;
                        set `searchString` = "\\p{Cntrl}";
                        set `replaceString` = " ";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String errorMessage;
                        }
                        copy `value` -> `errorMessage`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                MAP {
                    mapTarget {
                        String errorTail;
                    }
                    set (variable) `errorTail` = ",\"error\":{\"code\":\"%errorCode%\",\"message\":\"%errorMessage%\"}}";
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String searchString;
                            String replaceString;
                            String useRegex;
                        }
                        copy `errorTail` -> `inString`;
                        set `searchString` = "%errorCode%";
                        set `replaceString` = "";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String errorTail;
                        }
                        copy `value` -> `errorTail`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        mapTarget {
                            String searchString;
                            String replaceString;
                            String useRegex;
                        }
                        copy `callbackJson` -> `inString`;
                        set `searchString` = "[}]$";
                        set `replaceString` = "";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String callbackJson;
                        }
                        copy `value` -> `callbackJson`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.string:concat {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `callbackJson` -> `inString1`;
                        copy `errorTail` -> `inString2`;
                    }
                    output {
                        mapTarget {
                            String callbackJson;
                        }
                        copy `value` -> `callbackJson`;
                        drop `value`;
                        drop `inString1`;
                        drop `inString2`;
                        drop `errorTail`;
                    }
                }
            }
            MAP {
                drop `i3Error`;
            }
            TRY {
                INVOKE pub.client:http {
                    validateInput: false
                    validateOutput: false
                    input {
                        set `url` = "http://158.23.160.94/step/api/v1/publication-status";
                        set `method` = "post";
                        set `timeout` = "30000";
                        copy `callbackJson` -> `data`/`string`;
                        set `data`/`encoding` = "UTF-8";
                        copy `callbackHeaders` -> `headers`;
                    }
                }
                MAP {
                    mapSource {
                        record header;
                    }
                    mapTarget {
                        String i3HttpStatus;
                    }
                    copy `header`/`status` -> `i3HttpStatus`;
                    drop `body`;
                    drop `header`;
                    drop `data`;
                    drop `headers`;
                    drop `url`;
                    drop `method`;
                    drop `timeout`;
                    drop `encodedURL`;
                }
            } CATCH {
                INVOKE pub.flow:getLastError {
                    validateInput: false
                    validateOutput: false
                }
                MAP {
                    mapTarget {
                        String i3Error;
                    }
                    set (variable) `i3Error` = "%lastError/error%";
                    drop `body`;
                    drop `header`;
                    drop `data`;
                    drop `headers`;
                    drop `url`;
                    drop `method`;
                    drop `timeout`;
                    drop `encodedURL`;
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `i3Error` -> `inString`;
                        set `searchString` = "(?s)^.*ISC[.]0064[.]9314.*$";
                        set `replaceString` = "401";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String i3Error;
                        }
                        copy `value` -> `i3Error`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `i3Error` -> `inString`;
                        set `searchString` = "(?s)^(?:(?:.*?[^0-9])?([45][0-9]{2})(?![0-9]).*|.*)$";
                        set `replaceString` = "$1";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String i3HttpStatus;
                        }
                        copy `value` -> `i3HttpStatus`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                IF (i3HttpStatus==$null||i3HttpStatus=="") {
                    MAP {
                        mapTarget {
                            String i3HttpStatus;
                        }
                        set `i3HttpStatus` = "ERROR";
                    }
                }
            }
            INVOKE pub.flow:debugLog {
                validateInput: false
                validateOutput: false
                input {
                    mapTarget {
                        String message;
                        String function;
                        String level;
                    }
                    set (variable) `message` = "Callback I3 SAP %callbackStatus% -> HTTP %i3HttpStatus%: %callbackJson%";
                    set `function` = "project.femsa_financial_mdm.integrations:propagateFinancialDataSVC";
                    set `level` = "Info";
                }
                output {
                    drop `message`;
                    drop `function`;
                    drop `level`;
                }
            }
            IF (i3HttpStatus!="200"&&i3HttpStatus!="201"&&i3HttpStatus!="202"&&i3HttpStatus!="204") {
                MAP {
                    mapTarget {
                        String httpCode;
                        String errorDump;
                    }
                    set `httpCode` = "500";
                    set (variable) `errorDump` = "Falha no callback I3 SAP (HTTP %i3HttpStatus%) para %sapCanonical/meta/globalMasterId% [callback %callbackStatus%]: %i3Error%";
                }
                INVOKE pub.string:replace {
                    validateInput: false
                    validateOutput: false
                    input {
                        copy `errorDump` -> `inString`;
                        set `searchString` = "%[^% ]*%";
                        set `replaceString` = "";
                        set `useRegex` = "true";
                    }
                    output {
                        mapTarget {
                            String errorDump;
                        }
                        copy `value` -> `errorDump`;
                        drop `value`;
                        drop `inString`;
                        drop `searchString`;
                        drop `replaceString`;
                        drop `useRegex`;
                    }
                }
                EXIT {
                    exitFrom: "mainFlow"
                    signal: "FAILURE"
                    failureMessage: "Falha no callback I3 SAP"
                }
            }
            MAP {
                mapTarget {
                    String sapOk;
                }
                set `sapOk` = "false";
                drop `i3Error`;
            }
            IF (httpStatus=="200"||httpStatus=="202") {
                IF (publicationStatus=="APPLIED") {
                    MAP {
                        mapTarget {
                            String sapOk;
                        }
                        set `sapOk` = "true";
                    }
                }
            }
            IF (sapOk!="true") {
                IF (publicationStatus=="REJECTED"||publicationStatus=="QUARANTINED") {
                    MAP {
