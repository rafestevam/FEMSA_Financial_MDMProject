interface project.femsa_financial_mdm.integrations
service propagateToOracle (
    output {
        String message;
    }
)
properties {
    favorite: false;
    deprecated: false;
    visible: private;
    reuse: private;
    stateless: true;
    cacheResults: false;
    cacheExpire: 15;
    prefetch: false;
    prefetchActivation: 1;
    pipelineDebug: None;
    allowedHttpMethods: [TRACE, HEAD, DELETE, POST, GET, OPTIONS, PUT, PATCH];
    maxRetryAttempts: 0;
    retryInterval: 0;
    enableAuditing: never;
    logOn: Error only;
    includePipeline: never;
    circuitBreakerEnabled: false;
    failureEvent: Exception only;
    timeoutPeriod: 60;
    cancelThreadOnTimeout: false;
    failureThreshold: 5;
    failurePeriod: 60;
    circuitOpenAction: Throw exception;
    circuitResetPeriod: 300;
    concurrencyEnabled: false;
    maxConcurrentRequests: 20;
    validateInput: false;
    validateOutput: false;
}
{
    INVOKE pub.string:concat {
        validateInput: false
        validateOutput: false
        input {
            mapTarget {
                String inString1;
                String inString2;
            }
            set `inString1` = "Oracle ";
            set `inString2` = "propagated!";
        }
        output {
            mapTarget {
                String message;
            }
            drop `inString1`;
            drop `inString2`;
            drop `value`;
            copy `value` -> `message`;
        }
    }
}
